# Públicas: Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privadas: exclusivamente en servidor / Vercel Environment Variables
SUPABASE_SERVICE_ROLE_KEY=
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Versión habilitada en tu aplicación de Meta; ejemplo, v23.0
META_GRAPH_VERSION=v23.0
